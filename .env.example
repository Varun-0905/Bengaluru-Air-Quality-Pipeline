# Copy to .env (never commit .env)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional: Telegram alerts (create a bot with @BotFather, get chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: LLM wording for the weekly summary (any OpenAI-compatible endpoint with a free tier)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
